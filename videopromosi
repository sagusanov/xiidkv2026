    <script>
        // 1. Parsing Query URL parameter for student name (e.g. materi.html?to=Zahira)
        const urlParams = new URLSearchParams(window.location.search);
        const toStudent = urlParams.get('to');
        if (toStudent) {
            document.getElementById('student-name').innerText = toStudent;
        }

        // 2. OPEN MODULE & MUSIC PLAYER LOGIC
        function openModule() {
            const cover = document.getElementById('cover-overlay');
            const main = document.getElementById('main-content');
            const audioBtn = document.getElementById('audio-toggle-btn');
            const audio = document.getElementById('bg-audio');

            cover.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                cover.classList.add('hidden');
                main.classList.remove('opacity-0');
                audioBtn.classList.remove('hidden');
            }, 800);

            audio.play().catch(error => {
                console.log("Audio autoplay prevented by browser.");
            });
        }

        // 3. AUDIO TOGGLE
        let isPlaying = true;
        function toggleAudio() {
            const audio = document.getElementById('bg-audio');
            const icon = document.getElementById('audio-icon');

            if (isPlaying) {
                audio.pause();
                icon.classList.remove('animate-spin');
                icon.classList.replace('fa-compact-disc', 'fa-play');
            } else {
                audio.play();
                icon.classList.add('animate-spin');
                icon.classList.replace('fa-play', 'fa-compact-disc');
            }
            isPlaying = !isPlaying;
        }

        // 4. COPY VOICE OVER SCRIPT
        function copyVO(btn) {
            const voText = document.getElementById('vo-script-text').innerText;
            const tempInput = document.createElement('textarea');
            tempInput.value = voText;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            const origContent = btn.innerHTML;
            btn.innerHTML = `<i class="fa-solid fa-check"></i> Naskah VO Tersalin!`;
            btn.classList.replace('bg-cinema-gold', 'bg-emerald-500');
            setTimeout(() => {
                btn.innerHTML = origContent;
                btn.classList.replace('bg-emerald-500', 'bg-cinema-gold');
            }, 2000);
        }
    </script>
